{
  "project": "Yare Monster",
  "url": "https://yare.monster",
  "repository": "https://github.com/YareMonster/YareMonster",
  "licence": "Yare Monster Community License 1.0 (LICENSE)",
  "requires": [
    "Your own Supabase project",
    "Your own Cloudflare account",
    "Optionally, your own domain"
  ],
  "accountAccess": "Only emails on the deployment's allow list may create an account: select public.yare_allow_email('you@domain.com')",
  "install": {
    "singleApp": [
      "git clone <repository>",
      "cd <folder>",
      "npm install",
      "copy .env.example to .env and fill the two public Supabase values",
      "npx supabase login && npm run db:push",
      "npx supabase db query \"select public.yare_allow_email('<email>')\" --linked",
      "npm run build && npx wrangler deploy"
    ],
    "severalApps": [
      "same, but push every database once from the repository root: node scripts/db-push.mjs --project-ref <ref> [slugs...]"
    ]
  },
