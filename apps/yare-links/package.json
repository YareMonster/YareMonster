{
  "name": "yare-links",
  "version": "0.7.0",
  "private": true,
  "description": "Yare Links: part of Yare Monster. Every link you have on one page: a grid of blocks you place and size, on your own Supabase and Cloudflare.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 4622",
    "build": "tsc -b && vite build && node write-public-config.mjs",
    "preview": "vite preview --port 4722",
    "check": "tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "db:link": "supabase link",
    "db:push": "node scripts/db-push.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.118.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^1.5.4",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^6.1.0",
    "supabase": "^2.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "wrangler": "^4.0.0"
  }
}
