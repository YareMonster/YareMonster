{
  // Cloudflare Workers: the built app as static assets, plus a small Worker (worker.js) that fills
  // a page's <head> for search engines, messaging apps and agents. `npm run build` then
  // `npx wrangler deploy`. Or connect the repository in the Cloudflare dashboard with root
  // directory `apps/yare-links`, build command `npm run build` and deploy command
  // `npx wrangler deploy`. See DEPLOYMENT.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yare-links",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Lets Cloudflare build a preview of a branch before it merges (`wrangler preview`).
  "previews": {}
}
